VITE_APP_SUPABASE_URL=https://cqnfziultbkobdkegtfm.supabase.co
VITE_APP_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
VITE_APP_GOOGLE_AUTH_ENABLED=false
VITE_APP_QA_EMAIL=qa@activeselfcontrol.local
VITE_APP_QA_PASSWORD=replace-with-local-qa-password

# Supabase Edge Function secrets (configure with `supabase secrets set`, never in Vite)
# WHATSAPP_ACCESS_TOKEN=replace-with-meta-system-user-token
# WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
# WHATSAPP_GRAPH_API_VERSION=vXX.X
# N8N_WHATSAPP_WEBHOOK_URL=https://n8n.example.com/webhook/asc-whatsapp-dispatch
# N8N_WHATSAPP_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes

# CRM invitation email (Supabase Edge Function secrets; never expose as VITE_*)
# Hostinger normally uses port 465 with SSL or port 587 with STARTTLS.
# APP_SITE_URL=https://app.example.com
# SMTP_ENABLED=true
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME="MultiLot 360"
# SMTP_REPLY_TO_EMAIL=support@example.com
# If deployment still uses the legacy names, set MAILERSEND_ENABLED=true and
# use the same Hostinger values below. The prefix is only backwards compatibility.
# MAILERSEND_ENABLED=true
# MAILERSEND_SMTP_HOST=smtp.hostinger.com
# MAILERSEND_SMTP_PORT=465
# MAILERSEND_SMTP_USER=no-reply@example.com
# MAILERSEND_SMTP_PASSWORD=replace-with-hostinger-password
# MAILERSEND_FROM_EMAIL=no-reply@example.com
# MAILERSEND_FROM_NAME="MultiLot 360"
